# Client-side. Both ship in the JS bundle by design: the browser needs them to
# open the Realtime socket for presence and signals. With RLS enabled and no
# policies, this key can do nothing against the database.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SERVER ONLY. Bypasses RLS entirely. No NEXT_PUBLIC_ prefix, so Next never
# inlines it into client code. On Vercel add it as a secret Environment
# Variable, never as Config.
# Supabase dashboard > Project Settings > API > service_role / secret key.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXX
